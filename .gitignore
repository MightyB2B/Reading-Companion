# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cargo build output. At the repository root since the workspace split: it
# used to sit under src-tauri/ and be covered by that crate's own .gitignore,
# which no longer reaches it.
/target/

# Database credentials, written by scripts/setup-postgres.ps1
.env

# Page photographs held by a locally-run library server. Someone's books, and
# megabytes each — this is the reader's data, not the project's.
/library/

# Artefacts install-server.ps1 gathers beside itself when run from a checkout:
# a 17MB binary and the 40MB dictionary, both regenerable.
/scripts/reading-server.exe
/scripts/dict.sqlite
/scripts/.env
/scripts/postgres-superuser-password.txt

# Dictionary build: the 23MB Webster's source and the 40MB database it
# produces are both regenerable with `node scripts/build-dictionary.mjs`.
.cache
src-tauri/resources/dict.sqlite

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
